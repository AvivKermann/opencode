{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
        "opencode-gemini-auth@1.3.10",
        "opencode-openai-codex-auth@latest"
    ],
  "model": "openai/gpt-6-astra",
  "default_agent": "kermintor",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "deny",
      "jira": "allow",
      "jira *": "allow",
      "jira*&&*": "deny",
      "jira*;*": "deny",
      "jira*|*": "deny",
      "kubectl *": "allow",
      "glab *": "allow",
      "python3 *": "allow",
    },
    "webfetch": "allow"
  }
}
